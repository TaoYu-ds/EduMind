# TutorMesh 环境变量
# docker compose 部署时会自动读取此文件

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=xxx
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# api.deepseek.com 的限时客服调用默认关闭思考，避免占满 JSON/正文的输出预算。

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=tutormesh123
# docker compose 内部地址（容器间通信）
REDIS_URL=redis://:tutormesh123@redis:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
# docker compose 内部地址（连接独立 ChromaDB 服务）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 本地降级路径（仅 development；production 连接失败时中止启动）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
# 仅 development 自动导入示例政策；生产空库不会自动添加示例。
TUTORMESH_SEED_DEMO_DOCS=true

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# 每次模型请求的超时（秒）；聊天请求另有 50 秒总预算。
TUTORMESH_INTENT_TIMEOUT_S=8
TUTORMESH_LLM_TIMEOUT_S=15
TUTORMESH_COMPOSER_TIMEOUT_S=8
# 普通后台画像的最短更新间隔；明确表达偏好时立即更新。设 0 恢复逐轮更新。
PROFILE_UPDATE_MIN_INTERVAL_S=60

# ── 标准 MCP ─────────────────────────────────────────────────────────────────
# 默认连接无需 Key 的 Microsoft Learn 公开文档 MCP；设 false 可关闭外部连接。
MCP_EXTERNAL_ENABLED=true
# 不填时读取当前项目 config/mcp_servers.json，Docker 内默认路径同样可用。
# MCP_SERVERS_CONFIG=/app/config/mcp_servers.json
# 通过自定义域名访问 /mcp/ 时，将域名加入允许列表（逗号分隔）。
# MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,tutormesh,tutormesh:*,tutormesh-python,tutormesh-python:*,your-domain.example
# MCP_ALLOWED_ORIGINS=https://your-domain.example,http://localhost,http://localhost:*

# 本地默认 development；对外部署设置 production 并配置独立随机 API Token（不是模型 Key）。
TUTORMESH_ENV=development
# TUTORMESH_API_TOKENS={"至少24位随机Token":{"user_id":"u1","role":"user"},"另一管理员Token至少24位":{"user_id":"admin","role":"admin"}}

# 三路意图识别：有硅基流动 Key 自动启用当前免费版 BAAI/bge-m3；无 Key 使用本地 n-gram。
# 不使用收费的 Pro/BAAI/bge-m3，不与 ANTHROPIC_API_KEY 共用。
INTENT_EMBEDDING_ENABLED=true
INTENT_EMBEDDING_PROVIDER=auto
SILICONFLOW_API_KEY=

# 混合检索权重：BM25 关键词召回与向量召回的分数各自 min-max 归一化后加权相加。
# 默认对齐 Java 版的 bm25-weight 0.45 / vector-weight 0.55。
# 设 TUTORMESH_BM25_WEIGHT=0 可退化为纯向量检索，用于 A/B 对照（见 evaluation/retrieval_eval.py）。
TUTORMESH_BM25_WEIGHT=0.45
TUTORMESH_VECTOR_WEIGHT=0.55

# ── 工具策略 / 编排 / 工单 ────────────────────────────────────────────────────
# 按意图收敛工具白名单；false 回到纯角色白名单，便于对照实验。
TUTORMESH_TOOL_POLICY=true
# legacy = 手写 AgentOrchestrator；graph = LangGraph 状态图编排。
TUTORMESH_WORKFLOW_ENGINE=legacy
TUTORMESH_WORKFLOW_MAX_RETRIES=1
# 转人工/教师工单的 JSON 存储路径（单进程实现，生产应替换为工单系统）。
TUTORMESH_TICKET_PATH=/app/data/tickets.json
